---
import type { NoteEntry, NoteTreeNode } from "../lib/notes";
import { noteHref } from "../lib/notes";

interface Props {
  nodes: NoteTreeNode[];
  current: NoteEntry;
}

const { nodes, current } = Astro.props;
---

<ul class="tree-list">
  {
    nodes.map((node) => (
      <li>
        <a href={noteHref(node.note)} aria-current={node.note.id === current.id ? "page" : undefined}>
          {node.note.data.title}
        </a>
        {node.children.length > 0 && <Astro.self nodes={node.children} current={current} />}
      </li>
    ))
  }
</ul>

<style>
  .tree-list {
    display: grid;
    gap: 0.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tree-list .tree-list {
    border-left: 1px solid #ded5ca;
    margin: 0.25rem 0 0.35rem 0.45rem;
    padding-left: 0.7rem;
  }

  .tree-list a {
    display: block;
    border-radius: 4px;
    color: #40372e;
    font-family:
      ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 0.9rem;
    line-height: 1.25;
    overflow-wrap: anywhere;
    padding: 0.2rem 0.35rem;
    text-decoration: none;
  }

  .tree-list a:hover {
    background: #eee6da;
  }

  .tree-list a[aria-current="page"] {
    background: #235a86;
    color: #fff;
  }
</style>
